{
    "compilerOptions": {
        "target": "ES2022",
        "rootDir": "./src",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
